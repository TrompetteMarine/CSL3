# Copy to .env (never commit .env). Every value below is a placeholder.
POSTGRES_PASSWORD=change-me
OTREE_ADMIN_PASSWORD=change-me
OTREE_SECRET_KEY=change-me-to-a-long-random-string
# optional: key for the REST and export API (header "otree-rest-key")
OTREE_REST_KEY=
# STUDY = participants need their link, the admin pages need the password; DEMO = demo page open
OTREE_AUTH_LEVEL=STUDY
# files inside ./schedules and ./pools
# format-3 files; a seed wave (config market_seed) needs one drawn with --no-social
MARKET_SCHEDULE=schedules/example_seed0_4pairs_v3.json
MARKET_SEED_SCHEDULE=schedules/example_seed0_4pairs_v3_nosocial.json
MARKET_POOL=pools/pool.json
HOST_PORT=8000
